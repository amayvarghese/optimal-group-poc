NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/optimal_ai_operations?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

MS_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MS_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MS_CLIENT_SECRET=replace_with_your_client_secret
ENTRA_INVITE_REDIRECT_URL=https://portal.azure.com

# Azure Communication Services Email (preferred for OTP; domain must be verified in ACS)
ACS_CONNECTION_STRING=endpoint=https://<resource>.communication.azure.com/;accesskey=...
ACS_EMAIL_SENDER=DoNotReply@your-verified-domain.com

# SMTP (fallback if ACS is not configured)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your-mailbox@outlook.com
SMTP_PASS=your-mailbox-password-or-app-password
SMTP_FROM=your-mailbox@outlook.com

# Quotes module (admin): MongoDB collections requests-clients & requests-quotes are created on first write.
# API prefix: /api/newquote-api (see backend/newquoteApi.js).
# Client lookup by name: GET /api/newquote-api/clients/lookup?name=...&q=... (admin or OPS_API_KEY).
# Optional: static key for private/script access (same value every time). Send as
#   X-API-Key: <OPS_API_KEY>   or   Authorization: Bearer <OPS_API_KEY>
# When unset, only normal JWT login works for those routes.
OPS_API_KEY=
